# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration
# Leave DATABASE_URL empty or unset to use embedded PostgreSQL (PGlite) automatically,
# or set to a real PostgreSQL instance: postgresql://postgres:postgres@localhost:5432/bidstorm
DATABASE_URL=
USE_EMBEDDED_POSTGRES=true
DATA_DIR=./data

# JWT Authentication
JWT_SECRET=super_secret_bidstorm_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Redis (Optional: Used for multi-node event distribution / scaling if available)
REDIS_URL=redis://localhost:6379

# Concurrency & Rate Limiting
BID_RATE_LIMIT_WINDOW_MS=1000
BID_RATE_LIMIT_MAX_REQUESTS=100
